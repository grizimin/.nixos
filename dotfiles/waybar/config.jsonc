[
  {
    "include": "/home/grizimin/.config/waybar/modules.jsonc",
    "height": 31,
    "layer": "top",
    "mode": "dock",
    "exclusive": true,
    "passtrough": false,
    "gtk-layer-shell": true,
    "margin-top": 0,
    "margin-left": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "on-scroll-threshold": 1,
    "modules-left": [
      "hyprland/workspaces",
      "custom/arrow-left-no1"
    ],
    "modules-center": [
      "custom/arrow-right-no1",
      "clock#date",
      "custom/arrow-right-re0",
      "hyprland/window",
      "custom/arrow-left-re0",
      "clock#time",
      "custom/arrow-left-no1"
    ],
    "modules-right": [
      "custom/arrow-right-no1",
      "memory",
      "tray"
    ]
  }
]
